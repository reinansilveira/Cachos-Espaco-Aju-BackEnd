generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  PROFESSIONAL
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
}

enum ProductType {
  SALE
  INTERNAL_USE
}

enum ProductUnit {
  UNIT
  ML
  G
}

enum StockMovementType {
  IN
  SALE
  INTERNAL_USE
  ADJUSTMENT
  LOSS
  RETURN
}

enum OrderStatus {
  OPEN
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

enum OrderItemType {
  SERVICE
  PRODUCT
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum NotificationType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// ============================================================================
// MODELO: Users
// ============================================================================

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model User {
  id                 String    @id @default(uuid())
  email              String?   @unique
  password           String?
  name               String
  phone              String?   @unique
  avatar             String?
  gender             Gender?
  role               UserRole  @default(CLIENT)
  active             Boolean   @default(true)
  emailVerified      Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  passwordSetAt      DateTime?
  sessionVersion     Int       @default(0)
  twoFactorEnabled   Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resetCode          String?
  resetCodeExpires   DateTime?

  client                   Client?
  professional             Professional?
  appointmentsCreated      Appointment[]             @relation("AppointmentCreator")
  refreshTokens            RefreshToken[]
  roleAssignments          UserRoleAssignment[]
  passwordResetTokens      PasswordResetToken[]
  receivedNotifications    Notification[]            @relation("NotificationRecipient")
  notificationReadReceipts NotificationReadReceipt[]
  stockMovements           StockMovement[]
  ordersOpened             Order[]                   @relation("OrderOpenedBy")
  orderPayments            OrderPayment[]

  @@index([email])
  @@index([role, active])
  @@map("users")
}

// `role` remains the legacy/default role while this table represents every
// context that the same account is allowed to use (for example ADMIN +
// PROFESSIONAL). Keeping both fields makes the rollout backward compatible.
model UserRoleAssignment {
  userId    String
  role      UserRole
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role, userId])
  @@map("user_roles")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Client {
  id     String @id @default(uuid())
  userId String @unique

  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?

  reengagementSentAt DateTime?
  cpfCnpj            String?
  gatewayCustomerId  String?   @unique
  notes              String?   @db.Text
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user                    User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments            Appointment[]
  reviews                 Review[]
  notificationPreferences ClientNotificationPreference?
  orders                  Order[]

  @@index([active])
  @@map("clients")
}

model ClientNotificationPreference {
  clientId        String   @id
  emailEnabled    Boolean  @default(true)
  smsEnabled      Boolean  @default(true)
  whatsappEnabled Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_notification_preferences")
}

model PhoneVerification {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@index([expiresAt])
}

// ============================================================================
// MODELO: Professional
// ============================================================================

model Professional {
  id           String   @id @default(uuid())
  userId       String   @unique
  specialty    String?
  bio          String?  @db.Text
  experience   Int?
  commission   Decimal  @default(0) @db.Decimal(5, 2)
  active       Boolean  @default(true)
  rating       Decimal? @default(0) @db.Decimal(3, 2)
  totalReviews Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments         Appointment[]
  timeSlots            TimeSlot[]
  professionalServices ProfessionalService[]
  reviews              Review[]
  schedules            Schedule[]
  orderItems           OrderItem[]

  @@index([active])
  @@index([rating])
  @@map("professionals")
}

// ============================================================================
// MODELO: Service
// ============================================================================

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  duration    Int
  price       Decimal  @db.Decimal(10, 2)
  category    String?
  image       String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professionalServices ProfessionalService[]
  appointments         Appointment[]
  orderItems           OrderItem[]

  @@index([active])
  @@index([category])
  @@map("services")
}

// ============================================================================
// MODELO: ProfessionalService
// ============================================================================

model ProfessionalService {
  professionalId String
  serviceId      String
  customPrice    Decimal? @db.Decimal(10, 2)
  customDuration Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([professionalId, active])
  @@map("professional_services")
}

// ============================================================================
// MODELO: Schedule
// ============================================================================

model Schedule {
  id             String    @id @default(uuid())
  professionalId String
  date           DateTime? // nova coluna, opcional
  dayOfWeek      Int? // mantém para rotina semanal
  startTime      String
  endTime        String
  breakStart     String?
  breakEnd       String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, dayOfWeek, active])
  @@index([professionalId, date, active])
  @@map("schedules")
}

// ============================================================================
// MODELO: Appointment
// ============================================================================

model Appointment {
  id             String            @id @default(uuid())
  clientId       String
  professionalId String
  serviceId      String
  createdById    String?
  scheduledAt    DateTime
  endsAt         DateTime
  startedAt      DateTime?
  completedAt    DateTime?
  status         AppointmentStatus @default(PENDING)
  duration       Int
  price          Decimal           @db.Decimal(10, 2)
  notes          String?           @db.Text
  cancelReason   String?           @db.Text
  reminderSent   Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  client        Client         @relation(fields: [clientId], references: [id])
  professional  Professional   @relation(fields: [professionalId], references: [id])
  service       Service        @relation(fields: [serviceId], references: [id])
  createdBy     User?          @relation("AppointmentCreator", fields: [createdById], references: [id])
  order         Order?
  review        Review?
  timeSlot      TimeSlot?
  notifications Notification[]

  @@index([scheduledAt])
  @@index([professionalId, scheduledAt])
  @@index([clientId, scheduledAt])
  @@index([status])
  @@index([scheduledAt, status])
  @@map("appointments")
}

// ============================================================================
// MODELO: Review
// ============================================================================

model Review {
  id             String    @id @default(uuid())
  appointmentId  String    @unique
  clientId       String
  professionalId String
  rating         Int
  comment        String?   @db.Text
  response       String?   @db.Text
  respondedAt    DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([professionalId, active])
  @@index([rating])
  @@map("reviews")
}

model TimeSlot {
  id             String   @id @default(uuid())
  professionalId String
  startsAt       DateTime
  available      Boolean  @default(true)
  appointmentId  String?  @unique
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])

  @@unique([professionalId, startsAt])
  @@index([professionalId, available, startsAt])
  @@map("time_slots")
}

// ============================================================================
// MODELO: Notification
// ============================================================================

model Notification {
  id              String             @id @default(uuid())
  appointmentId   String?
  recipientUserId String?
  recipient       String
  idempotencyKey  String?            @unique
  type            NotificationType
  status          NotificationStatus @default(PENDING)
  subject         String?
  message         String             @db.Text
  metadata        Json?
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  errorMessage    String?            @db.Text
  attempts        Int                @default(0)
  maxAttempts     Int                @default(3)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  appointment   Appointment?              @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  recipientUser User?                     @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  readReceipts  NotificationReadReceipt[]

  @@index([status, attempts])
  @@index([appointmentId])
  @@index([createdAt])
  @@index([recipientUserId, createdAt])
  @@map("notifications")
}

model NotificationReadReceipt {
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_read_receipts")
}

// ============================================================================
// MODELO: Configuration
// ============================================================================

model Configuration {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  type        String   @default("string")
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("configurations")
}

// O id do evento enviado pelo gateway é a chave: reentregas são ignoradas.
model GatewayWebhookEvent {
  id          String   @id
  provider    String
  type        String
  payload     Json
  processedAt DateTime @default(now())

  @@index([provider, type])
  @@map("gateway_webhook_events")
}

// ============================================================================
// MODELO: Estoque
// ============================================================================

// `SALE` é vendido às clientes e entra na comanda; `INTERNAL_USE` é consumido
// durante os serviços e só sai do estoque por baixa manual.
model Product {
  id            String      @id @default(uuid())
  name          String
  brand         String?
  description   String?     @db.Text
  type          ProductType
  unit          ProductUnit @default(UNIT)
  salePrice     Decimal?    @db.Decimal(10, 2)
  costPrice     Decimal?    @db.Decimal(10, 2)
  stockQuantity Int         @default(0)
  minStock      Int         @default(0)
  barcode       String?     @unique
  image         String?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  movements  StockMovement[]
  orderItems OrderItem[]

  @@index([type, active])
  @@index([name])
  @@map("products")
}

// `quantity` tem sinal (entrada positiva, saída negativa) e `balanceAfter`
// guarda o saldo depois do movimento para o histórico não depender de soma.
model StockMovement {
  id           String            @id @default(uuid())
  productId    String
  type         StockMovementType
  quantity     Int
  balanceAfter Int
  unitCost     Decimal?          @db.Decimal(10, 2)
  reason       String?           @db.Text
  orderId      String?
  createdById  String?
  createdAt    DateTime          @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([type, createdAt])
  @@map("stock_movements")
}

// ============================================================================
// MODELO: Comanda
// ============================================================================

model Order {
  id            String      @id @default(uuid())
  number        Int         @unique @default(autoincrement())
  clientId      String?
  appointmentId String?     @unique
  status        OrderStatus @default(OPEN)
  subtotal      Decimal     @default(0) @db.Decimal(10, 2)
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  total         Decimal     @default(0) @db.Decimal(10, 2)
  notes         String?     @db.Text
  openedById    String?
  closedAt      DateTime?
  paidAt        DateTime?
  cancelledAt   DateTime?
  cancelReason  String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  openedBy       User?           @relation("OrderOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       OrderPayment[]
  stockMovements StockMovement[]

  @@index([status, createdAt])
  @@index([clientId])
  @@index([paidAt])
  @@map("orders")
}

// Nome e preço são copiados no momento em que o item entra, para a comanda
// não mudar se o catálogo for editado depois.
model OrderItem {
  id             String        @id @default(uuid())
  orderId        String
  type           OrderItemType
  serviceId      String?
  productId      String?
  professionalId String?
  description    String
  quantity       Int           @default(1)
  unitPrice      Decimal       @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// `gateway = true`: cobrança no Asaas (Pix com QR ou link de cartão), confirmada
// pelo webhook. `gateway = false`: maquininha, dinheiro ou Pix direto na chave,
// registrado na hora por quem fecha a comanda.
model OrderPayment {
  id               String        @id @default(uuid())
  orderId          String
  method           PaymentMethod
  gateway          Boolean       @default(false)
  // Sinal pago no agendamento online: abate do total e não quita a comanda.
  isDeposit        Boolean       @default(false)
  status           PaymentStatus @default(PENDING)
  amount           Decimal       @db.Decimal(10, 2)
  gatewayPaymentId String?       @unique
  invoiceUrl       String?
  pixPayload       String?       @db.Text
  dueDate          DateTime?
  paidAt           DateTime?
  refundedAt       DateTime?
  notes            String?       @db.Text
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([status, paidAt])
  @@map("order_payments")
}
